NODE_ENV=development
PORT=8080
ATLAS_RELEASE=V150
# Enable tenant-authenticated event ingress only after a reviewed workflow handler is deployed.
ATLAS_WORKFLOW_EVENT_INGRESS_ENABLED=false
ATLAS_DATABASE_URL=
ATLAS_DATABASE_SSL_CA_FILE=
ATLAS_MIGRATION_DATABASE_URL=
ATLAS_SESSION_SECRET=
ATLAS_ACTION_APPROVAL_KEY=
ATLAS_PLATFORM_OWNER_EMAIL=
ATLAS_PUBLIC_ORIGIN=
ATLAS_HEALTH_TOKEN=
ATLAS_DB_POOL_MAX=10
ATLAS_WORKER_DATABASE_URL=
ATLAS_WORKER_HANDLERS_MODULE=v125-production.mjs
ATLAS_WORKER_SECRET_RESOLVER_MODULE=
ATLAS_INBOX_CONTENT_MODULE=
ATLAS_WEBHOOK_SECRET_RESOLVER_MODULE=
ATLAS_WORKER_ID=
ATLAS_WORKER_CONCURRENCY=4
ATLAS_WORKER_LEASE_SECONDS=60
ATLAS_WORKER_POLL_MS=1000
ATLAS_TRUST_PROXY=false
ATLAS_EMAIL_PROVIDER=console
ATLAS_EMAIL_PROVIDER_TOKEN=
ATLAS_EMAIL_FROM=
ATLAS_EMAIL_MESSAGE_STREAM=outbound
ATLAS_PADDLE_ENVIRONMENT=sandbox
ATLAS_PADDLE_API_ORIGIN=https://sandbox-api.paddle.com
ATLAS_PADDLE_API_KEY=
ATLAS_PADDLE_WEBHOOK_SECRET=
ATLAS_PADDLE_PRICE_STARTER=
ATLAS_PADDLE_PRICE_GROWTH=
ATLAS_PADDLE_PRICE_SCALE=

# Durable P130 scheduler; enable only after migrations and production handler review.
ATLAS_WORKFLOW_SCHEDULER_ENABLED=false
ATLAS_WORKFLOW_SCHEDULER_INTERVAL_MS=5000
ATLAS_RUNTIME_POOL_ID=
ATLAS_SLO_EVALUATION_INTERVAL_MS=30000

# V139-V150 distributed runtime
ATLAS_REDIS_URL=
ATLAS_REDIS_TLS=true
ATLAS_REDIS_NAMESPACE=atlas
ATLAS_REDIS_CONNECT_TIMEOUT_MS=3000

ATLAS_AUTOSCALER_ENABLED=false
ATLAS_AUTOSCALER_ACTUATOR_URL=
ATLAS_AUTOSCALER_ACTUATOR_SECRET_REF=
ATLAS_AUTOSCALER_LEASE_SECONDS=60
ATLAS_AUTOSCALER_INTERVAL_MS=30000
ATLAS_AUTOSCALER_MIN_WORKERS=1
ATLAS_AUTOSCALER_MAX_WORKERS=20

ATLAS_ALERT_ROUTER_ENABLED=false
ATLAS_ALERT_ROUTER_INTERVAL_MS=15000
ATLAS_ALERT_ROUTER_SECRET_RESOLVER_REF=

ATLAS_OTLP_ENDPOINT=
ATLAS_OTLP_AUTH_SECRET_REF=
ATLAS_OTLP_TIMEOUT_MS=3000
ATLAS_RUNTIME_CONTROL_EVENTS_ENABLED=false

ATLAS_DEPLOYMENT_EVIDENCE_REQUIRED=true
ATLAS_PRODUCTION_MANIFEST=infra/production/atlas-production.manifest.json
ATLAS_EVIDENCE_DIR=infra/production/evidence
