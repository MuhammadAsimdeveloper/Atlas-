NODE_ENV=development
PORT=8080
ATLAS_RELEASE=V120
ATLAS_DATABASE_URL=
ATLAS_DATABASE_SSL_CA_FILE=
ATLAS_MIGRATION_DATABASE_URL=
ATLAS_SESSION_SECRET=
ATLAS_ACTION_APPROVAL_KEY=
# Set this to Khan's actual verified owner mailbox before production.
ATLAS_PLATFORM_OWNER_EMAIL=
ATLAS_PUBLIC_ORIGIN=
ATLAS_HEALTH_TOKEN=
# Required in production for /health/ready; use a random value of at least 32 bytes.
ATLAS_DB_POOL_MAX=10
ATLAS_WORKER_DATABASE_URL=
ATLAS_WORKER_HANDLERS_MODULE=
ATLAS_WORKER_ID=
ATLAS_WORKER_CONCURRENCY=4
ATLAS_WORKER_LEASE_SECONDS=60
ATLAS_WORKER_POLL_MS=1000
# Development default; production requires the HTTPS edge to overwrite X-Real-IP.
ATLAS_TRUST_PROXY=false
ATLAS_EMAIL_PROVIDER=console
ATLAS_EMAIL_PROVIDER_TOKEN=
ATLAS_EMAIL_FROM=
ATLAS_EMAIL_MESSAGE_STREAM=outbound
ATLAS_PADDLE_ENVIRONMENT=sandbox
# Optional: must remain the canonical Paddle API origin for the selected environment.
ATLAS_PADDLE_API_ORIGIN=https://sandbox-api.paddle.com
ATLAS_PADDLE_API_KEY=
ATLAS_PADDLE_WEBHOOK_SECRET=
# Each Paddle price must be active, recurring and configured with a free 14-day trial.
ATLAS_PADDLE_PRICE_STARTER=
ATLAS_PADDLE_PRICE_GROWTH=
ATLAS_PADDLE_PRICE_SCALE=
